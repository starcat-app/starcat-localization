    "settings.labs.typesafe.enable.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routes manual repo-grouping and tag-suggestion generation to TypeSafe's Jev model — fast, calibrated typed decisions instead of LLM text generation. Falls back to your configured AI provider when off or unconfigured."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将手动触发的仓库分组与标签建议切换到 TypeSafe Jev 模型：快速、带校准概率的类型化决策，而非 LLM 文本生成。关闭或未配置时自动回退已配置的 AI Provider。"
          }
        }
      }
    },
