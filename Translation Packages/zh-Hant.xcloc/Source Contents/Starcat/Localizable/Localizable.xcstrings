            "state" : "translated",
            "value" : "批量标签建议使用 Jev"
          }
        }
      }
    },
    "settings.labs.typesafe.tags.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to tag-only batch runs. Jev can only pick from your existing tag vocabulary and never invents new tag names; mixed summary+tag insight runs keep using your AI provider."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅对纯标签批量任务生效。Jev 只能从现有标签词表中选择、不会创造新标签名；摘要+标签混合任务仍走 AI Provider。"
          }
        }
      }
    },
    "settings.labs.typesafe.tags.hybrid.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For tag-only batch runs, Jev first reuses matching existing tags. If fewer than your configured minimum match, your AI provider generates at most one new tag; mixed summary+tag runs continue using the AI provider."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "纯标签批量任务会先由 Jev 复用匹配的现有标签；少于你设置的最小数量时，再由 AI Provider 生成最多一个新标签。摘要+标签混合任务仍走 AI Provider。"
          }
        }
      }
    },
    "settings.labs.typesafe.scope.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scope: manual triggers only; suggestions still require your confirmation before anything is written. Jev results carry calibrated probabilities (shown as \"Jev P=…\" in the reason field)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "边界：仅手动触发；所有建议仍需你确认后才会写入。Jev 结果携带校准概率（在理由栏显示为 \"Jev P=…\"）。"
          }
        }
      }
    },
    "settings.labs.typesafe.enable.unified.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routes repository grouping and tag suggestions through TypeSafe's Jev model — fast, calibrated typed decisions instead of LLM text generation. Falls back to your configured AI provider when disabled or unconfigured."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将仓库分组与标签建议切换到 TypeSafe Jev 模型：使用快速、带校准概率的类型化决策，而非 LLM 文本生成。关闭或未配置时自动回退到已配置的 AI Provider。"
          }
        }
      }
    },
    "settings.labs.typesafe.grouping.unified" : {
      "extractionState" : "manual",
