    "githubStarLists.aiGrouping.filter.automaticallyIgnored.persistentReason" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These repositories belong to organizations that restrict OAuth app access. Starcat keeps them visible in each grouping session but skips them in later runs to avoid repeated failures. After an organization owner approves Starcat, retry one repository or retry all manually."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些仓库所在组织限制了 OAuth 应用访问。Starcat 会在每次整理中保留展示，但后续不会重复处理，避免反复失败。组织管理员批准 Starcat 后，可手动重试单个仓库或全部重试。"
          }
        }
      }
