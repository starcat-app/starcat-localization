          }
        }
      }
    },
    "rag.workspace.inspector.retrievalScore.cosine" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosine similarity: the raw semantic similarity between the question and this chunk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "余弦相似度：问题与该分片的原始语义相似度。"
          }
        }
      }
    },
    "rag.workspace.inspector.retrievalScore.explanationTitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrieval score"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "综合检索分说明"
          }
        }
      }
    },
    "rag.workspace.inspector.retrievalScore.formula.hybrid" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "score = (keyword RRF + keyword score × 0.12 + vector RRF + cosine similarity × 0.20) × source weight + preferred-repo boost"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "综合检索分 =（关键词 RRF + 字面命中分 × 0.12 + 向量 RRF + 余弦相似度 × 0.20）× 来源权重 + @repo 偏好加成"
          }
        }
      }
    },
    "rag.workspace.inspector.retrievalScore.formula.keyword" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "score = (1.0 / (60 + keyword rank) + keyword score × 0.12) × source weight + preferred-repo boost"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "综合检索分 =（1.0 /（60 + 关键词排名）+ 字面命中分 × 0.12）× 来源权重 + @repo 偏好加成"
          }
        }
      }
    },
    "rag.workspace.inspector.retrievalScore.formula.repositoryInsights" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repository-level structured evidence; it is not ranked as an indexed chunk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仓库级结构化证据，不参与索引分片排序。"
          }
        }
      }
    },
    "rag.workspace.inspector.retrievalScore.formula.vector" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "score = (1.15 / (60 + vector rank) + cosine similarity × 0.20) × source weight + preferred-repo boost"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "综合检索分 =（1.15 /（60 + 向量排名）+ 余弦相似度 × 0.20）× 来源权重 + @repo 偏好加成"
          }
        }
      }
    },
    "rag.workspace.inspector.retrievalScore.formulaLabel" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculation formula"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计算公式"
          }
        }
      }
    },
    "rag.workspace.inspector.retrievalScore.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show score formula"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看计算公式"
          }
        }
      }
    },
    "rag.workspace.inspector.retrievalScore.keyword" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyword score: the normalized rank of an exact text match; its weight is 0.12."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字面命中分：严格文本匹配的归一化排名分，权重为 0.12。"
          }
        }
      }
    },
    "rag.workspace.inspector.retrievalScore.preferBoost" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferred-repo boost: an explicit @repo preference adds 0.08; otherwise it is 0."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偏好加成：显式 @repo 偏好时额外加 0.08，否则为 0。"
          }
        }
      }
    },
    "rag.workspace.inspector.retrievalScore.rank" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RRF rank term: weight / (60 + rank), so rank refines rather than dominates the result."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RRF 排名项：权重 /（60 + 排名），让排名只细化结果而不主导结果。"
          }
        }
