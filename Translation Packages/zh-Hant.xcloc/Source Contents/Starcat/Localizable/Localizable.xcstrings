            "state" : "translated",
            "value" : "Use Jev for repository grouping"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仓库分组使用 Jev"
          }
        }
      }
    },
    "settings.labs.typesafe.grouping.unified.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to both manually started grouping and background auto-grouping. Jev supplies calibrated probabilities; Starcat validates candidates and applies your configured confidence threshold before any automatic write."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时用于手动发起的仓库分组与后台自动分组。Jev 提供校准概率；任何自动写入前，Starcat 仍会校验候选分组并应用你设置的置信度阈值。"
          }
        }
      }
    },
    "settings.labs.typesafe.tags.unified" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Jev for tag suggestions"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签建议使用 Jev"
          }
        }
      }
    },
    "settings.labs.typesafe.tags.unified.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to single-repository suggestions, tag-only batches, mixed summary-and-tag tasks, and Auto Tidy. Jev first reuses matching existing tags; when too few qualify and new tags are allowed, your AI provider generates at most one new tag."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于单仓标签建议、纯标签批量、摘要与标签混合任务以及自动整理。Jev 会优先复用匹配的现有标签；达到阈值的标签不足且允许新增时，再由 AI Provider 生成最多一个新标签。"
          }
        }
      }
    },
    "settings.labs.typesafe.tags.pooled.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to single-repository suggestions, tag-only batches, mixed summary-and-tag tasks, and Auto Tidy. Jev first reuses matching existing tags. In manual batches that allow new tags, uncovered repositories are pooled into one AI request; confirm up to five shared tags before reclassification. Auto Tidy never expands the vocabulary."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于单仓标签建议、纯标签批量、摘要与标签混合任务以及自动整理。Jev 会优先复用匹配的现有标签；人工批量允许新增时，未覆盖仓库只汇总为一次 AI 请求，确认最多 5 个全局标签后再重新归类。自动整理不会扩充词表。"
          }
        }
      }
    },
    "settings.labs.typesafe.scope.unified.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scope: Jev only supplies decisions and probabilities; Starcat keeps candidate validation, confidence thresholds, and write rules. Manual suggestions require confirmation, while enabled automatic actions can apply results that meet your threshold. Probabilities appear as \"Jev P=…\" in the reason field."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "边界：Jev 只提供决策与概率；候选校验、置信度阈值和写入规则仍由 Starcat 控制。手动建议需要确认；启用自动操作时，达到阈值的结果可自动应用。概率会在理由栏显示为 \"Jev P=…\"。"
          }
        }
      }
    },
