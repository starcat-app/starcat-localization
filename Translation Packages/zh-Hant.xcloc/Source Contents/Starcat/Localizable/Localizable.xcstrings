    "localai.logs.clearAll.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently delete all local AI log files and window records. Models, active tasks, and exported copies are not affected. New activity will continue to be logged. System Console logs follow macOS retention and cannot be cleared here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久删除全部本地 AI 日志文件与窗口记录，不影响模型、正在运行的任务和已导出的副本。之后的新活动会继续记录。系统 Console 日志由 macOS 管理，无法在这里清除。"
          }
        }
      }
    },
